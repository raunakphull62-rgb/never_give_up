// Parity corpus: branches and boolean logic (shared subset).
// NOTE: no `!` here — the v2 grammar has no unary-not, so `!` programs
// live outside the three-backend agreement set by construction.

fn mymax(a: i32, b: i32) -> i32 {
    if a < b {
        return b
    } else {
        return a
    }
}

fn main() -> i32 {
    print(mymax(20, 22))
    if 1 <= 1 && 2 >= 2 && 3 != 4 {
        print(42)
    } else {
        print(0)
    }
    let a = 0 || 0
    if a {
        print(1)
    } else {
        print(7)
    }
    return 0
}
