// Parity corpus: deep recursion trips the 1024-frame depth cap.
// v1 + v2 fail loud E-RUNTIME. The JIT enforces the same 1024-frame
// guard and reports the same E-RUNTIME (Wave1 S5 — agree, no allowlist).

fn countdown(n: i32) -> i32 {
    if n <= 0 {
        return 0
    }
    return countdown(n - 1) + 1
}

fn main() -> i32 {
    return countdown(2000)
}
