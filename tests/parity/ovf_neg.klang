// Parity corpus: negation overflow (0 - MIN).
// v1 + v2 fail loud E-OVERFLOW. The JIT computes wrapping i64 (result
// MIN, exit code low byte 0) with no error — a silent wrong answer
// (allowlisted).

fn mymin() -> i64 {
    return 0 - 9223372036854775807 - 1
}

fn main() -> i32 {
    return 0 - mymin()
}
