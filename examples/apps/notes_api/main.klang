fn handle(req: map) -> map {
    if (req["method"] == "GET") {
        if (req["path"] == "/health") {
            return http_json(200, {"status": "ok"})
        }
        if (req["path"] == "/notes") {
            try {
                let db = pg_connect(get_env("DATABASE_URL"))
                let rows = pg_query(db, "SELECT id, text FROM notes ORDER BY id", [])
                pg_close(db)
                return http_json(200, rows)
            } catch e {
                if (e["code"] == "E-PG-CONNECT") {
                    return http_json(503, {"error": "db unavailable"})
                }
                return http_json(500, {"error": "internal server error"})
            }
        }
        let m = route_match("/notes/:id", req["path"])
        if (is_null(m) == false) {
            try {
                let db = pg_connect(get_env("DATABASE_URL"))
                let rows = pg_query(db, "SELECT id, text FROM notes WHERE id = $1", [parse_int(m["id"])])
                pg_close(db)
                if (len(rows) == 0) {
                    return http_text(404, "not found")
                }
                return http_json(200, rows[0])
            } catch e {
                if (e["code"] == "E-PG-CONNECT") {
                    return http_json(503, {"error": "db unavailable"})
                }
                return http_json(500, {"error": "internal server error"})
            }
        }
    }
    if (req["method"] == "POST") {
        if (req["path"] == "/notes") {
            let v = {}
            try {
                v = json_decode(req["body"])
            } catch e {
                return http_text(400, "bad json")
            }
            try {
                let text = v["text"]
                let db = pg_connect(get_env("DATABASE_URL"))
                let rows = pg_query(db, "INSERT INTO notes (text) VALUES ($1) RETURNING id", [text])
                let id = rows[0]["id"]
                pg_close(db)
                return http_json(200, {"id": id})
            } catch e {
                if (e["code"] == "E-PG-CONNECT") {
                    return http_json(503, {"error": "db unavailable"})
                }
                return http_json(500, {"error": "internal server error"})
            }
        }
    }
    if (req["method"] == "DELETE") {
        let m = route_match("/notes/:id", req["path"])
        if (is_null(m) == false) {
            try {
                let db = pg_connect(get_env("DATABASE_URL"))
                let r = pg_exec(db, "DELETE FROM notes WHERE id = $1", [parse_int(m["id"])])
                pg_close(db)
                if (r["changes"] == 0) {
                    return http_text(404, "not found")
                }
                return http_json(200, {"deleted": 1})
            } catch e {
                if (e["code"] == "E-PG-CONNECT") {
                    return http_json(503, {"error": "db unavailable"})
                }
                return http_json(500, {"error": "internal server error"})
            }
        }
    }
    return http_text(404, "not found")
}

fn main() -> i32 {
    signal_watch("TERM")
    signal_watch("INT")
    let db_url = get_env("DATABASE_URL")
    if (db_url == "") {
        print("missing DATABASE_URL")
        return 1
    }
    let db = pg_connect(db_url)
    pg_exec(db, "CREATE TABLE IF NOT EXISTS notes (id SERIAL PRIMARY KEY, text TEXT NOT NULL)", [])
    pg_close(db)
    let port_str = get_env("PORT")
    let port = 0
    if (port_str != "") {
        port = parse_int(port_str)
    }
    let s = http_serve("0.0.0.0", port, "handle", {"workers": 4})
    print(("listening on " + str(server_port(s))))
    let port_file = get_env("PORT_FILE")
    if (port_file != "") {
        write_file(port_file, str(server_port(s)))
    }
    while (signal_pending("TERM") == false) {
        if (signal_pending("INT") == true) {
            break
        }
        sleep_ms(50)
    }
    print("shutting down")
    http_stop(s)
    return 0
}
