// examples/eval.klang — Phase 2 Session 4 dogfood: a small expression
// evaluator combining generics + enums + modules + effects in one program.
//
// Stage 2: top-level AST/result enums + parser module. The parser returns
// `Res` (Ok = POut tree, Err = syntax error code) so syntax failures are
// values the driver reports per input line instead of aborting the run.
//
// Run: cargo run -- run examples/eval.klang main

// The AST. Recursive payloads (`l: Expr`) erase to `unknown` at the use
// site (the enum is not yet registered while its own variants resolve),
// so construction and matching stay dynamic while exhaustiveness over the
// six variants is still enforced wherever the scrutinee is nominal.
enum Expr { Num(x: i32), Var(name: str), Add(l: Expr, r: Expr), Sub(l: Expr, r: Expr), Mul(l: Expr, r: Expr), Div(l: Expr, r: Expr) }

// Generic result: `Res::Ok` carries any `T` (trees from the parser, ints
// from the evaluator), `Res::Err` carries a numeric error code.
enum Res<T> { Ok(v: T), Err(code: i32) }

// Generic defaulting over `Res`: instantiated with both `POut`-shaped and
// `i32`-shaped results in this program.
fn expect<T>(r: Res, dflt: T) -> T {
    return match r { Res::Ok(v) => v, Res::Err(c) => dflt }
}

mod lexer {
    pub struct Tok { kind: i32, value: i32, name: str }

    // Token kinds. The language has no const items, so kinds are small
    // `pub fn` accessors; intra-module callers use them bare.
    pub fn k_eof() -> i32 { return 0 }
    pub fn k_num() -> i32 { return 1 }
    pub fn k_plus() -> i32 { return 2 }
    pub fn k_minus() -> i32 { return 3 }
    pub fn k_star() -> i32 { return 4 }
    pub fn k_div() -> i32 { return 5 }
    pub fn k_lparen() -> i32 { return 6 }
    pub fn k_rparen() -> i32 { return 7 }
    pub fn k_ident() -> i32 { return 8 }

    fn is_digit(c: str) -> i32 {
        if "0" <= c && c <= "9" {
            return 1
        } else {
            return 0
        }
    }

    fn is_alpha(c: str) -> i32 {
        if "a" <= c && c <= "z" {
            return 1
        } else {
            return 0
        }
    }

    // Arrays/maps are dynamically typed (SPEC section 2: `unknown`
    // leniency), so the token stream is `array` here and at every
    // boundary that carries it.
    // NOTE (F11): `&&` evaluates both sides eagerly (no short-circuit),
    // so bounds guards must be nested `if`s, never `a < n && s[a] ...`.
    // `is_digit`/`is_alpha` may keep `&&`: both sides are pure string
    // comparisons with no failure mode under eager evaluation.
    pub fn scan(src: str) -> array {
        let toks = []
        let i = 0
        let n = len(src)
        while i < n {
            let c = src[i]
            if c == " " {
                i = i + 1
            } else if is_digit(c) == 1 {
                let v = 0
                while i < n {
                    if is_digit(src[i]) == 1 {
                        v = v * 10 + int(src[i])
                        i = i + 1
                    } else {
                        break
                    }
                }
                push(toks, Tok { kind: k_num(), value: v, name: "" })
            } else if is_alpha(c) == 1 {
                let w = ""
                while i < n {
                    if is_alpha(src[i]) == 1 {
                        w = w + src[i]
                        i = i + 1
                    } else {
                        break
                    }
                }
                push(toks, Tok { kind: k_ident(), value: 0, name: w })
            } else if c == "+" {
                push(toks, Tok { kind: k_plus(), value: 0, name: "" })
                i = i + 1
            } else if c == "-" {
                push(toks, Tok { kind: k_minus(), value: 0, name: "" })
                i = i + 1
            } else if c == "*" {
                push(toks, Tok { kind: k_star(), value: 0, name: "" })
                i = i + 1
            } else if c == "/" {
                push(toks, Tok { kind: k_div(), value: 0, name: "" })
                i = i + 1
            } else if c == "(" {
                push(toks, Tok { kind: k_lparen(), value: 0, name: "" })
                i = i + 1
            } else if c == ")" {
                push(toks, Tok { kind: k_rparen(), value: 0, name: "" })
                i = i + 1
            } else {
                push(toks, Tok { kind: -1, value: 0, name: c })
                i = i + 1
            }
        }
        push(toks, Tok { kind: k_eof(), value: 0, name: "" })
        return toks
    }

    // Private on purpose: the E-PRIVATE gate (module_gates) pins that
    // cross-module use of this is a compile error.
    fn secret() -> i32 { return 1 }
}

mod parser {
    // Parse output: the tree plus the position after it. `expr: Expr`
    // names the top-level enum from inside a module (F1 combination).
    pub struct POut { expr: Expr, pos: i32 }

    // A token at `pos`, nominally typed: field accesses on the result
    // (`.kind`, `.value`, `.name`) are statically checked (F10).
    fn tok_at(toks: array, pos: i32) -> lexer::Tok {
        return toks[pos]
    }

    fn peek_kind(toks: array, pos: i32) -> i32 {
        let t = tok_at(toks, pos)
        return t.kind
    }

    fn parse_factor(toks: array, pos: i32) -> Res {
        let t = tok_at(toks, pos)
        if t.kind == lexer::k_num() {
            return Res::Ok(POut { expr: Expr::Num(t.value), pos: pos + 1 })
        }
        if t.kind == lexer::k_ident() {
            return Res::Ok(POut { expr: Expr::Var(t.name), pos: pos + 1 })
        }
        if t.kind == lexer::k_lparen() {
            return match parse_expr(toks, pos + 1) {
                Res::Err(c) => Res::Err(c),
                Res::Ok(p) => check_rparen(toks, p)
            }
        }
        return Res::Err(1)
    }

    fn check_rparen(toks: array, p: POut) -> Res {
        if peek_kind(toks, p.pos) == lexer::k_rparen() {
            return Res::Ok(POut { expr: p.expr, pos: p.pos + 1 })
        }
        return Res::Err(2)
    }

    fn parse_term(toks: array, pos: i32) -> Res {
        return match parse_factor(toks, pos) {
            Res::Err(c) => Res::Err(c),
            Res::Ok(l) => term_rest(toks, l)
        }
    }

    fn term_rest(toks: array, l: POut) -> Res {
        let k = peek_kind(toks, l.pos)
        if k == lexer::k_star() {
            return match parse_factor(toks, l.pos + 1) {
                Res::Err(c) => Res::Err(c),
                Res::Ok(r) => term_rest(toks, POut { expr: Expr::Mul(l.expr, r.expr), pos: r.pos })
            }
        }
        if k == lexer::k_div() {
            return match parse_factor(toks, l.pos + 1) {
                Res::Err(c) => Res::Err(c),
                Res::Ok(r) => term_rest(toks, POut { expr: Expr::Div(l.expr, r.expr), pos: r.pos })
            }
        }
        return Res::Ok(l)
    }

    fn parse_expr(toks: array, pos: i32) -> Res {
        return match parse_term(toks, pos) {
            Res::Err(c) => Res::Err(c),
            Res::Ok(l) => expr_rest(toks, l)
        }
    }

    fn expr_rest(toks: array, l: POut) -> Res {
        let k = peek_kind(toks, l.pos)
        if k == lexer::k_plus() {
            return match parse_term(toks, l.pos + 1) {
                Res::Err(c) => Res::Err(c),
                Res::Ok(r) => expr_rest(toks, POut { expr: Expr::Add(l.expr, r.expr), pos: r.pos })
            }
        }
        if k == lexer::k_minus() {
            return match parse_term(toks, l.pos + 1) {
                Res::Err(c) => Res::Err(c),
                Res::Ok(r) => expr_rest(toks, POut { expr: Expr::Sub(l.expr, r.expr), pos: r.pos })
            }
        }
        return Res::Ok(l)
    }

    // Error codes: 1 = unexpected token, 2 = missing `)`,
    // 3 = trailing garbage after a complete expression.
    pub fn parse(toks: array) -> Res {
        return match parse_expr(toks, 0) {
            Res::Err(c) => Res::Err(c),
            Res::Ok(p) => check_trailing(toks, p)
        }
    }

    fn check_trailing(toks: array, p: POut) -> Res {
        if peek_kind(toks, p.pos) == lexer::k_eof() {
            return Res::Ok(p)
        }
        return Res::Err(3)
    }
}

mod eval {
    // Environment lookup over parallel name/value arrays. A missing map
    // key is a runtime failure, so names are guarded with a linear scan
    // and absence is a `Res::Err` value instead.
    //
    // Declared `throws`: environment access is the evaluator's effect
    // boundary (Klang has no `throw` expression — effects are
    // propagation-checked annotations), so every evaluator path must
    // propagate it. Removing `throws` from any function in the
    // lookup <- run <- main chain is a compile error (E-EFFECT-MISMATCH),
    // pinned by the eval gates test.
    fn lookup(names: array, vals: array, want: str) -> Res throws {
        let i = 0
        for n in names {
            if n == want {
                return Res::Ok(vals[i])
            }
            i = i + 1
        }
        return Res::Err(5)
    }

    fn calc(op: i32, x: i32, y: i32) -> Res {
        if op == 1 {
            return Res::Ok(x + y)
        }
        if op == 2 {
            return Res::Ok(x - y)
        }
        if op == 3 {
            return Res::Ok(x * y)
        }
        if op == 4 {
            if y == 0 {
                return Res::Err(4)
            }
            return Res::Ok(x / y)
        }
        return Res::Err(6)
    }

    // `throws` because both operands are computed by `run`, which throws:
    // the effect propagates through the argument positions, not just
    // through statement sequencing.
    fn apply(op: i32, a: Res, b: Res) -> Res throws {
        return match a {
            Res::Err(c) => Res::Err(c),
            Res::Ok(x) => match b {
                Res::Err(c) => Res::Err(c),
                Res::Ok(y) => calc(op, x, y)
            }
        }
    }

    // Error codes: 4 = division by zero, 5 = undefined variable
    // (6 = unknown operator, unreachable from the parser).
    pub fn run(e: Expr, names: array, vals: array) -> Res throws {
        return match e {
            Expr::Num(x) => Res::Ok(x),
            Expr::Var(n) => lookup(names, vals, n),
            Expr::Add(l, r) => apply(1, run(l, names, vals), run(r, names, vals)),
            Expr::Sub(l, r) => apply(2, run(l, names, vals), run(r, names, vals)),
            Expr::Mul(l, r) => apply(3, run(l, names, vals), run(r, names, vals)),
            Expr::Div(l, r) => apply(4, run(l, names, vals), run(r, names, vals))
        }
    }
}

// One input line, end to end: scan, parse, evaluate. Parse failures
// report 1000 + code, evaluation failures 2000 + code, so the driver
// keeps going line by line instead of aborting on the first bad input.
fn eval_src(src: str, names: array, vals: array) -> i32 throws {
    return match parser::parse(lexer::scan(src)) {
        Res::Err(c) => 1000 + c,
        Res::Ok(p) => match eval::run(p.expr, names, vals) {
            Res::Err(c) => 2000 + c,
            Res::Ok(v) => v
        }
    }
}

fn main() -> i32 throws {
    let names = ["x", "y"]
    let vals = [10, 3]
    print(eval_src("2 + 3 * 4", names, vals))
    print(eval_src("(2 + 3) * 4", names, vals))
    print(eval_src("x * y + 1", names, vals))
    print(eval_src("10 / 2 - 1", names, vals))
    print(eval_src("10 / 0", names, vals))
    print(eval_src("x + zzz", names, vals))
    print(eval_src("2 +", names, vals))
    print(eval_src("(2 + 3", names, vals))
    print(eval_src("2 3", names, vals))
    print(expect(eval::run(Expr::Num(40), names, vals), 0) + 2)
    return 0
}
