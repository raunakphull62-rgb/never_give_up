// examples/real/minishell.klang — small interactive shell (S7 dogfood).
//
// Reads lines from stdin, runs commands with spawn(), supports cd, exit,
// env, and NAME=value. Prints the exit status of failed commands.
//
// Usage:
//   printf 'echo hi\nfalse\nexit\n' | klang run examples/real/minishell.klang
//   klang run examples/real/minishell.klang (interactive, Ctrl-D to quit)
//
// Notes (see docs/FINDINGS.md):
// - No chdir builtin: cd only updates a logical directory printed by pwd.
// - read_line() cannot tell empty line from EOF: "" quits the shell.
// - print() always adds a newline: the prompt lives on its own line.
fn is_digit_char(c: str) -> i32 {
    if (c >= "0") {
        if (c <= "9") {
            return 1
        }
    }
    return 0
}

fn is_alpha_char(c: str) -> i32 {
    if (c >= "a") {
        if (c <= "z") {
            return 1
        }
    }
    if (c >= "A") {
        if (c <= "Z") {
            return 1
        }
    }
    if (c == "_") {
        return 1
    }
    return 0
}

fn is_valid_env_name(name: str) -> i32 {
    if (name == "") {
        return 0
    }
    let chars = name.chars()
    let first = chars[0]
    if (is_alpha_char(first) == 0) {
        return 0
    }
    let i = 1
    while (i < len(chars)) {
        let c = chars[i]
        if (is_alpha_char(c) == 1) {
            i = (i + 1)
        } else if (is_digit_char(c) == 1) {
            i = (i + 1)
        } else {
            return 0
        }
    }
    return 1
}

fn split_shell(line: str) -> array {
    let out = []
    let cur = ""
    let seen = 0
    let in_single = 0
    let in_double = 0
    let chars = line.chars()
    let i = 0
    while (i < len(chars)) {
        let c = chars[i]
        if (in_single == 1) {
            if (c == "'") {
                in_single = 0
            } else {
                cur = (cur + c)
                seen = 1
            }
            i = (i + 1)
        } else if (in_double == 1) {
            if (c == "\"") {
                in_double = 0
            } else {
                cur = (cur + c)
                seen = 1
            }
            i = (i + 1)
        } else if (c == "'") {
            in_single = 1
            seen = 1
            i = (i + 1)
        } else if (c == "\"") {
            in_double = 1
            seen = 1
            i = (i + 1)
        } else if (c == " ") {
            if (seen == 1) {
                push(out, cur)
                cur = ""
                seen = 0
            }
            i = (i + 1)
        } else if (c == "\t") {
            if (seen == 1) {
                push(out, cur)
                cur = ""
                seen = 0
            }
            i = (i + 1)
        } else {
            cur = (cur + c)
            seen = 1
            i = (i + 1)
        }
    }
    if (seen == 1) {
        push(out, cur)
    }
    return out
}

fn strip_one_newline(s: str) -> str {
    if s.ends_with("\n") {
        let n = len(s.chars())
        return slice(s, 0, (n - 1))
    }
    return s
}

fn join_from(parts: array, start: i32, sep: str) -> str {
    let out = ""
    let first = 1
    let i = start
    while (i < len(parts)) {
        if (first == 1) {
            out = parts[i]
            first = 0
        } else {
            out = ((out + sep) + parts[i])
        }
        i = (i + 1)
    }
    return out
}

fn normalize_path(p: str) -> str {
    let is_abs = 0
    if p.starts_with("/") {
        is_abs = 1
    }
    let parts = p.split("/")
    let stack = []
    for part in parts {
        if (part == "") {
            continue
        }
        if (part == ".") {
            continue
        }
        if (part == "..") {
            if (len(stack) > 0) {
                pop(stack)
            }
            continue
        }
        push(stack, part)
    }
    let out = stack.join("/")
    if (is_abs == 1) {
        return ("/" + out)
    }
    if (out == "") {
        return "."
    }
    return out
}

fn main() -> i32 {
    let cur = cwd()
    while true {
        print(("$ " + cur))
        let line = read_line()
        if (line == "") {
            return 0
        }
        let t = line.trim()
        if (t == "") {
            continue
        }
        if (t == "exit") {
            return 0
        }
        if (t == "quit") {
            return 0
        }
        let toks = split_shell(t)
        if (len(toks) == 0) {
            continue
        }
        let cmd = toks[0]
        if (cmd == "cd") {
            if (len(toks) == 1) {
                let home = env("HOME")
                if (home == "") {
                    print(cur)
                } else {
                    let norm = normalize_path(home)
                    try {
                        if is_dir(norm) {
                            cur = norm
                            print(cur)
                        } else {
                            print(("cd: no such directory: " + home))
                        }
                    } catch e {
                        print(("cd: no such directory: " + home))
                    }
                }
                continue
            }
            let dest = toks[1]
            if (dest == "-") {
                print(cur)
                continue
            }
            let raw = ""
            if dest.starts_with("/") {
                raw = dest
            } else if cur.ends_with("/") {
                raw = (cur + dest)
            } else {
                raw = ((cur + "/") + dest)
            }
            let norm = normalize_path(raw)
            try {
                if is_dir(norm) {
                    cur = norm
                    print(cur)
                } else {
                    print(("cd: no such directory: " + dest))
                }
            } catch e {
                print(("cd: no such directory: " + dest))
            }
            continue
        }
        if (cmd == "pwd") {
            if (len(toks) == 1) {
                print(cur)
                continue
            }
        }
        if (cmd == "env") {
            if (len(toks) == 1) {
                try {
                    let r = spawn("env", [])
                    let so = r["stdout"]
                    if (so != "") {
                        print(strip_one_newline(so))
                    }
                    let se = r["stderr"]
                    if (se != "") {
                        print(strip_one_newline(se))
                    }
                } catch e {
                    print(e["code"])
                }
                continue
            }
            if (len(toks) == 2) {
                print(env(toks[1]))
                continue
            }
        }
        if (len(toks) == 1) {
            if toks[0].contains("=") {
                let eqparts = toks[0].split("=")
                let name = eqparts[0]
                if (is_valid_env_name(name) == 1) {
                    let val = join_from(eqparts, 1, "=")
                    try {
                        set_env(name, val)
                    } catch e {
                        print(e["code"])
                    }
                    continue
                }
            }
        }
        if (cmd == "exit") {
            if (len(toks) == 1) {
                return 0
            }
            try {
                return parse_int(toks[1])
            } catch e {
                print("exit: numeric argument required")
            }
            continue
        }
        let cargs = []
        let k = 1
        while (k < len(toks)) {
            push(cargs, toks[k])
            k = (k + 1)
        }
        try {
            let r = spawn(cmd, cargs)
            let so = r["stdout"]
            if (so != "") {
                print(strip_one_newline(so))
            }
            let se = r["stderr"]
            if (se != "") {
                print(strip_one_newline(se))
            }
            let code = r["status"]
            if (code != 0) {
                print(("exit: " + str(code)))
            }
        } catch e {
            print(("command not found: " + cmd))
        }
    }
    return 0
}
