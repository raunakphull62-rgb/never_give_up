// examples/real/logsum.klang — summarize a log file (S7 dogfood, S9 sort_by).
//
// Reads a log file with lines "TIMESTAMP LEVEL MESSAGE" and prints counts
// per level (INFO/WARN/ERROR), the top 5 most frequent messages, and the
// first/last timestamp.
//
// Usage:
//   klang run examples/real/logsum.klang -- /tmp/app.log
//
// Example input:
//   2026-10-11T10:00:00 INFO server started
//   2026-10-11T10:01:00 WARN low memory
//
// Notes (see docs/FINDINGS.md, S9):
// - No regex needed: parsing uses split(" ") and join.
// - S9 sort_by orders messages by count (stable, ascending; top-5 reads back from the end).
fn join_from(parts: array, start: i32, sep: str) -> str {
    let out = ""
    let first = 1
    let i = start
    while (i < len(parts)) {
        if (first == 1) {
            out = parts[i]
            first = 0
        } else {
            out = ((out + sep) + parts[i])
        }
        i = (i + 1)
    }
    return out
}

fn main() -> i32 {
    let a = args()
    if (len(a) == 0) {
        print("usage: logsum <file>")
        return 1
    }
    let path = a[0]
    let content = ""
    try {
        content = read_file(path)
    } catch e {
        print(("cannot read: " + path))
        print(e["code"])
        return 1
    }
    let lines = content.split("\n")
    let info = 0
    let warn = 0
    let err = 0
    let other = 0
    let counts = {}
    let first_ts = ""
    let last_ts = ""
    for line in lines {
        if (line.trim() == "") {
            continue
        }
        let parts = line.split(" ")
        if (len(parts) < 2) {
            other = (other + 1)
            continue
        }
        let ts = parts[0]
        let level = parts[1]
        let msg = ""
        if (len(parts) > 2) {
            msg = join_from(parts, 2, " ")
        } else {
            msg = "(empty)"
        }
        if (first_ts == "") {
            first_ts = ts
        }
        last_ts = ts
        if (level == "INFO") {
            info = (info + 1)
        } else if (level == "WARN") {
            warn = (warn + 1)
        } else if (level == "ERROR") {
            err = (err + 1)
        } else {
            other = (other + 1)
        }
        if (msg == "") {
            msg = "(empty)"
        }
        if counts.contains(msg) {
            counts[msg] = (counts[msg] + 1)
        } else {
            counts[msg] = 1
        }
    }
    print(("INFO: " + str(info)))
    print(("WARN: " + str(warn)))
    print(("ERROR: " + str(err)))
    print(("first: " + first_ts))
    print(("last: " + last_ts))
    print("top:")
    let msgs = keys(counts)
    let ordered = sort_by(msgs, fn(k: str) -> i32 {
    return counts[k]
})
    let total = len(ordered)
    let start = (total - 5)
    if (start < 0) {
        start = 0
    }
    let i = (total - 1)
    while (i >= start) {
        let k = ordered[i]
        print(((k + ": ") + str(counts[k])))
        i = (i - 1)
    }
    return 0
}
