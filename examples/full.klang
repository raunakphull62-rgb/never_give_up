// examples/full.klang — Klang v0.3 language tour.
//
// Run: cargo run -- examples/full.klang main

struct Point { x: i32, y: i32 }

fn sum_to(n: i32) -> i32 {
    let total = 0
    for i in 0..n {
        total = total + i
    }
    return total
}

fn avg(xs: i32) -> i32 {
    return 0
}

fn main() -> i32 {
    // while + assignment + comparison
    let total = 0
    let i = 1
    while i <= 10 {
        total = total + i
        i = i + 1
    }
    print(total)

    // arrays + push + len + for-in
    let nums = [20, 1, 21]
    push(nums, 0)
    print(len(nums))
    let s = 0
    for x in nums {
        s = s + x
    }
    print(s)

    // structs + field mutation
    let p = Point { x: 19, y: 20 }
    p.y = 23
    print(p.x + p.y)

    // floats + strings + methods + logic
    let f = 0.5 * 4.0 + 40.0
    let name = "klang"
    print("hi " + name)
    print(name.upper())
    if s == 42 && f == 42.0 && sum_to(10) == 45 && grade(85) == 3 {
        return total - 13
    } else {
        return 0
    }
}

fn config() -> i32 {
    let cfg = {"host": "local", "port": 8080}
    print(cfg.keys())
    cfg["port"] = 9090
    return len(cfg)
}

fn combine() -> i32 throws async {
    task_group {
        let a = spawn fetch_num(20)
        let b = spawn fetch_num(22)
        return await a + await b
    }
}

fn fetch_num(n: i32) -> i32 {
    return n
}

fn grade(s: i32) -> i32 {
    if s >= 90 {
        return 4
    } else if s >= 80 {
        return 3
    } else if s >= 70 {
        return 2
    } else {
        return 0
    }
}
