// path_test.klang — package self-test. Run: klang run path_test.klang
import "lib.klang"

fn main() -> i32 {
    assert(path_join("a/b", "c") == "a/b/c")
    assert(path_join("a/b/", "c") == "a/b/c")
    assert(path_join("a", "/c") == "/c")
    assert(path_join("", "c") == "c")
    assert(path_join("a", "") == "a")
    assert(path_join("/", "c") == "/c")
    assert(path_basename("a/b/c.txt") == "c.txt")
    assert(path_basename("c.txt") == "c.txt")
    assert(path_basename("a/b/") == "b")
    assert(path_basename("/") == "/")
    assert(path_dirname("a/b/c.txt") == "a/b")
    assert(path_dirname("c.txt") == ".")
    assert(path_dirname("/b") == "/")
    assert(path_dirname("a/b/") == "a")
    assert(path_extension("a.tar.gz") == "gz")
    assert(path_extension("Makefile") == "")
    assert(path_extension(".gitignore") == "")
    assert(path_stem("a.tar.gz") == "a.tar")
    assert(path_stem("Makefile") == "Makefile")
    assert(path_is_absolute("/a") == true)
    assert(path_is_absolute("a") == false)
    assert(path_normalize("a/./b") == "a/b")
    assert(path_normalize("a/b/../c") == "a/c")
    assert(path_normalize("/a/../c") == "/c")
    assert(path_normalize("/../c") == "/c")
    assert(path_normalize("a//b") == "a/b")
    assert(path_normalize("../a") == "../a")
    assert(path_normalize("") == ".")
    assert(path_normalize("/") == "/")
    let sp = path_split("a/b/c.txt")
    assert(sp["dir"] == "a/b")
    assert(sp["base"] == "c.txt")
    print("path: OK")
    return 0
}
