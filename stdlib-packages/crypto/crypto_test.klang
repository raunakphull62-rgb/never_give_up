// crypto_test.klang — package self-test. Run: klang run crypto_test.klang
import "lib.klang"

fn main() -> i32 {
    assert(crypto_hash("") == 0)
    assert(crypto_hash("abc") == 993)
    assert(crypto_hash("abc") == crypto_hash("abc"))
    assert(crypto_eq_const("sekret", "sekret") == true)
    assert(crypto_eq_const("sekret", "sekreT") == false)
    assert(crypto_eq_const("short", "longer") == false)
    assert(crypto_pin4(7) == "0007")
    assert(crypto_pin4(42) == "0042")
    assert(crypto_pin4(1234) == "1234")
    assert(crypto_sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert(crypto_sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(crypto_sha256("abc") == crypto_sha256("abc"))
    assert(crypto_hmac_sha256("Jefe", "what do ya want for nothing?") == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    print("crypto: OK")
    return 0
}
