// math_test.klang — package self-test. Run: klang run math_test.klang
import "lib.klang"

fn main() -> i32 {
    assert(math_abs(0 - 5) == 5)
    assert(math_abs(5) == 5)
    assert(math_max(3, 7) == 7)
    assert(math_min(3, 7) == 3)
    assert(math_clamp(10, 0, 5) == 5)
    assert(math_clamp(0 - 1, 0, 5) == 0)
    assert(math_pow(2, 10) == 1024)
    assert(math_fact(5) == 120)
    assert(math_circle_area(1.0) == 3.141592653589793)
    assert(math_sqrt(16.0) == 4.0)
    assert(math_sqrt(2.0) == 1.4142135623730951)
    assert(math_powf(2.0, 10.0) == 1024.0)
    assert(math_absf(0 - 2.5) == 2.5)
    assert(math_minf(3.0, 7.5) == 3.0)
    assert(math_maxf(3.5, 7.0) == 7.0)
    assert(math_floor(2.9) == 2.0)
    assert(math_floor(0 - 2.1) == 0 - 3.0)
    assert(math_ceil(2.1) == 3.0)
    assert(math_sin(0.0) == 0.0)
    assert(math_cos(0.0) == 1.0)
    assert(math_tan(0.0) == 0.0)
    assert(math_atan2(1.0, 1.0) == 0.7853981633974483)
    assert(math_log(1.0) == 0.0)
    assert(math_exp(0.0) == 1.0)
    assert(math_sin(math_pi() / 2.0) == 1.0)
    print("math: OK")
    return 0
}
