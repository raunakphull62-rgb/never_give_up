// fs_test.klang — package self-test. Run: klang run fs_test.klang
import "lib.klang"

fn main() -> i32 {
    let base = "/tmp/klang_fs_test"
    if fs_exists(base + ".txt") {
        fs_remove(base + ".txt")
    }
    assert(fs_write(base + ".txt", "hello") == 5)
    assert(fs_append(base + ".txt", " klang") == 6)
    assert(fs_read(base + ".txt") == "hello klang")
    assert(fs_exists(base + ".txt") == true)
    assert(fs_exists(base + "_missing.txt") == false)
    assert(fs_read_or(base + "_missing.txt", "dflt") == "dflt")
    assert(fs_read_or(base + ".txt", "dflt") == "hello klang")
    assert(fs_write_lines(base + "_lines.txt", ["a", "b", "c"]) == 5)
    let lines = fs_read_lines(base + "_lines.txt")
    assert(len(lines) == 3)
    assert(lines[0] == "a")
    assert(lines[2] == "c")
    assert(fs_write(base + "_crlf.txt", "x\r\ny\r\n") == 6)
    let crlf = fs_read_lines(base + "_crlf.txt")
    assert(len(crlf) == 2)
    assert(crlf[0] == "x")
    assert(crlf[1] == "y")
    assert(fs_copy_file(base + ".txt", base + "_copy.txt") == 11)
    assert(fs_read(base + "_copy.txt") == "hello klang")
    assert(fs_touch(base + "_new.txt") == 1)
    assert(fs_touch(base + "_new.txt") == 0)
    assert(fs_read(base + "_new.txt") == "")
    assert(len(fs_read_lines(base + "_new.txt")) == 0)
    fs_remove(base + ".txt")
    fs_remove(base + "_lines.txt")
    fs_remove(base + "_crlf.txt")
    fs_remove(base + "_copy.txt")
    fs_remove(base + "_new.txt")
    let dd = "/tmp/klang_fs_dir"
    assert(fs_make_dirs(dd + "/sub/deep") == 1)
    for stale in ["a.klang", "b.txt", "c.txt", "d.txt"] {
        if fs_exists(dd + "/" + stale) {
            fs_remove(dd + "/" + stale)
        }
    }
    if fs_is_dir(dd + "_solo") == false {
        assert(fs_make_dir(dd + "_solo") == 1)
    }
    assert(fs_is_dir(dd + "_solo") == true)
    assert(fs_is_dir(dd + "/sub") == true)
    assert(fs_is_dir(dd + ".txt") == false)
    assert(fs_is_file(base + "_missing2.txt") == false)
    fs_write(dd + "/a.klang", "x")
    fs_write(dd + "/b.txt", "yy")
    assert(fs_file_size(dd + "/b.txt") == 2)
    assert(fs_is_file(dd + "/b.txt") == true)
    assert(fs_list_dir(dd).join(",") == "a.klang,b.txt,sub")
    assert(fs_glob(dd, "*.klang").join(",") == "a.klang")
    assert(fs_glob(dd, "a.*").join(",") == "a.klang")
    assert(fs_glob(dd, "*").join(",") == "a.klang,b.txt,sub")
    assert(fs_glob(dd, "b.txt").join(",") == "b.txt")
    assert(fs_copy(dd + "/b.txt", dd + "/c.txt") == 2)
    assert(fs_read(dd + "/c.txt") == "yy")
    assert(fs_rename(dd + "/c.txt", dd + "/d.txt") == 1)
    assert(fs_exists(dd + "/c.txt") == false)
    let walked = fs_walk(dd)
    assert(walked.contains(dd + "/a.klang") == true)
    assert(walked.contains(dd + "/sub/deep") == true)
    assert(fs_is_dir(dd + "_solo") == true)
    print("fs: OK")
    return 0
}
