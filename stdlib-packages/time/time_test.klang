// time_test.klang — package self-test. Run: klang run time_test.klang
import "lib.klang"

fn main() -> i32 {
    let d = dur_add(dur_from_mins(1), dur_new(30))
    assert(dur_secs(d) == 90)
    assert(dur_mins(dur_from_hours(2)) == 120)
    assert(dur_to_string(dur_new(5)) == "5s")
    assert(dur_is_zero(dur_new(0)) == true)
    assert(dur_is_zero(d) == false)
    assert(time_is_leap_year(2000) == true)
    assert(time_is_leap_year(1900) == false)
    assert(time_is_leap_year(2024) == true)
    assert(time_is_leap_year(2023) == false)
    assert(time_days_in_month(2024, 2) == 29)
    assert(time_days_in_month(2023, 2) == 28)
    assert(time_days_in_month(2024, 4) == 30)
    assert(time_days_in_month(2024, 1) == 31)
    let e = time_to_civil(0.0)
    assert(e["year"] == 1970)
    assert(e["month"] == 1)
    assert(e["day"] == 1)
    assert(e["hour"] == 0)
    assert(time_from_civil(1970, 1, 1, 0, 0, 0) == 0.0)
    assert(time_from_civil(2024, 1, 1, 0, 0, 0) == 1704067200.0)
    assert(time_from_civil(2000, 2, 29, 0, 0, 0) == 951782400.0)
    let rt = time_to_civil(1791198009.0)
    assert(time_from_civil(rt["year"], rt["month"], rt["day"], rt["hour"], rt["minute"], rt["second"]) == 1791198009.0)
    assert(time_iso8601(0.0) == "1970-01-01T00:00:00Z")
    assert(time_iso8601(1704067200.0) == "2024-01-01T00:00:00Z")
    let p = time_parse_iso8601("2024-01-01T00:00:00Z")
    assert(p["ok"] == true)
    assert(p["year"] == 2024)
    assert(p["second"] == 0)
    assert(p["error"] == "")
    let bad = time_parse_iso8601("2024-13-01T00:00:00Z")
    assert(bad["ok"] == false)
    assert(bad["error"] == "line 1, col 6: month out of range")
    let bad2 = time_parse_iso8601("nope")
    assert(bad2["ok"] == false)
    assert(bad2["month"] == 0)
    assert(time_weekday(0.0) == 4)
    assert(time_weekday_name(0.0) == "Thu")
    assert(time_weekday(1704067200.0) == 1)
    assert(time_weekday_name(1704067200.0) == "Mon")
    assert(time_add_days(0.0, 1) == 86400.0)
    assert(time_add_hours(0.0, 25) == 90000.0)
    assert(time_format_duration(0) == "0s")
    assert(time_format_duration(90) == "1m 30s")
    assert(time_format_duration(90061) == "1d 1h 1m 1s")
    assert(time_format_duration(5) == "5s")
    print("time: OK")
    return 0
}
