// url_test.klang — package self-test. Run: klang run url_test.klang
import "lib.klang"

fn main() -> i32 {
    let u = url_parse("https://user:pw@example.com:8080/a/b?x=1&y=2#frag")
    assert(u["ok"] == true)
    assert(u["scheme"] == "https")
    assert(u["user"] == "user:pw")
    assert(u["host"] == "example.com")
    assert(u["port"] == "8080")
    assert(u["path"] == "/a/b")
    assert(u["query"] == "x=1&y=2")
    assert(u["fragment"] == "frag")
    assert(u["error"] == "")
    let simple = url_parse("http://example.com")
    assert(simple["ok"] == true)
    assert(simple["port"] == "")
    assert(simple["path"] == "/")
    assert(url_build(u) == "https://user:pw@example.com:8080/a/b?x=1&y=2#frag")
    let rt = url_parse(url_build(simple))
    assert(rt["host"] == "example.com")
    let v6 = url_parse("http://[::1]:9000/x")
    assert(v6["ok"] == true)
    assert(v6["host"] == "[::1]")
    assert(v6["port"] == "9000")
    let upper = url_parse("HTTP://EXAMPLE.COM/A")
    assert(upper["scheme"] == "http")
    assert(upper["host"] == "example.com")
    assert(upper["path"] == "/A")
    assert(url_parse("example.com/x")["ok"] == false)
    assert(url_parse("http://")["ok"] == false)
    assert(url_parse("http://[::1/x")["ok"] == false)
    assert(url_encode("a b/c?") == "a%20b%2Fc%3F")
    assert(url_encode("ABC-_.~09") == "ABC-_.~09")
    assert(url_encode("é") == "%C3%A9")
    let de = url_decode("a%20b%2Fc%3F")
    assert(de["ok"] == true)
    assert(de["value"] == "a b/c?")
    assert(url_decode("a+b")["value"] == "a b")
    assert(url_decode("%C3%A9")["value"] == "é")
    assert(url_decode("%")["ok"] == false)
    assert(url_decode("%ZZ")["ok"] == false)
    assert(url_decode("%ED%A0%80")["ok"] == false)
    let enc_rt = url_decode(url_encode("héllo wörld→"))
    assert(enc_rt["value"] == "héllo wörld→")
    let qp = url_query_parse("x=1&y=2&flag")
    assert(len(qp) == 3)
    assert(qp[0]["key"] == "x")
    assert(qp[0]["value"] == "1")
    assert(qp[2]["key"] == "flag")
    assert(qp[2]["value"] == "")
    assert(url_query_build([{"key": "a b", "value": "c&d"}]) == "a%20b=c%26d")
    print("url: OK")
    return 0
}
