// json_test.klang — package self-test. Run: klang run json_test.klang
import "lib.klang"

fn main() -> i32 {
    assert(json_quote("hi") == "\"hi\"")
    assert(json_int("age", 42) == "\"age\": 42")
    assert(json_str("name", "amy") == "\"name\": \"amy\"")
    assert(json_bool("ok", true) == "\"ok\": true")
    assert(json_obj2(json_int("a", 1), json_int("b", 2)) == "{ \"a\": 1, \"b\": 2 }")
    assert(json_arr2("1", "2") == "[1, 2]")
    assert(json_is_obj("{}") == true)
    assert(json_is_obj("[]") == false)
    let r = json_parse("{\"a\": 1, \"b\": [true, false, null, \"x\", 2.5]}")
    assert(r["ok"] == true)
    assert(r["error"] == "")
    let v = r["value"]
    assert(json_type(v) == "object")
    assert(json_get(v, "a") == 1)
    assert(json_type(json_get(v, "a")) == "int")
    let arr = json_get(v, "b")
    assert(json_type(arr) == "array")
    assert(json_is_true(json_at(arr, 0)) == true)
    assert(json_is_false(json_at(arr, 1)) == true)
    assert(json_is_null(json_at(arr, 2)) == true)
    assert(json_at(arr, 3) == "x")
    assert(json_type(json_at(arr, 4)) == "float")
    assert(json_type(json_at(arr, 0)) == "bool")
    assert(json_type(json_at(arr, 2)) == "null")
    assert(json_type("s") == "str")
    assert(json_type(7) == "int")
    let esc = json_parse("{\"q\": \"a\\\"b\\nA\"}")
    assert(esc["ok"] == true)
    assert(json_get(esc["value"], "q") == "a\"b\nA")
    let uni = json_parse("\"\\u0041\"")
    assert(uni["ok"] == true)
    assert(uni["value"] == "A")
    let uni2 = json_parse("\"\\u00e9\\u4e2d\"")
    assert(uni2["ok"] == true)
    assert(uni2["value"] == "é中")
    let badu = json_parse("\"\\ud800\"")
    assert(badu["ok"] == false)
    let coll = json_parse("{\"$json\": \"null\"}")
    assert(coll["ok"] == true)
    assert(json_type(coll["value"]) == "null")
    assert(json_is_null(coll["value"]) == true)
    let coll2 = json_parse("{\"$json\": 42}")
    assert(json_type(coll2["value"]) == "object")
    assert(json_get(coll2["value"], "$json") == 42)
    let e1 = json_parse("{\"a\": }")
    assert(e1["ok"] == false)
    let e2 = json_parse("{\"a\": 1,}")
    assert(e2["ok"] == false)
    let e3 = json_parse("[1, 2")
    assert(e3["ok"] == false)
    let e4 = json_parse("nul")
    assert(e4["ok"] == false)
    let e5 = json_parse("{\"a\" 1}")
    assert(e5["ok"] == false)
    assert(e5["error"] == "line 1, col 6: expected ':'")
    let e6 = json_parse("{\"a\": 01}")
    assert(e6["ok"] == false)
    let e7 = json_parse("1 2")
    assert(e7["ok"] == false)
    let e8 = json_parse("")
    assert(e8["ok"] == false)
    let pv = json_parse_or_assert("[1, 2]")
    assert(json_at(pv, 1) == 2)
    let pretty = json_pretty(json_parse_or_assert("{\"b\": [1, {\"c\": null}], \"a\": \"x\"}"), 2)
    assert(pretty == "{\n  \"b\": [\n    1,\n    {\n      \"c\": null\n    }\n  ],\n  \"a\": \"x\"\n}")
    assert(json_pretty(json_parse_or_assert("[]"), 2) == "[]")
    assert(json_pretty(json_parse_or_assert("{}"), 2) == "{}")
    print("json: OK")
    return 0
}
