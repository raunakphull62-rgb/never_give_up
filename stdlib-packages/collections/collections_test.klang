// collections_test.klang — package self-test. Run: klang run collections_test.klang
import "lib.klang"

fn main() -> i32 {
    let l = list_empty()
    l = list_push(l, 20)
    l = list_push(l, 22)
    assert(list_len(l) == 2)
    assert(list_get(l, 0) == 20)
    assert(list_sum(l) == 42)
    assert(list_max(list_new([1, 9, 3])) == 9)
    let s = stack_new()
    s = stack_push(s, 1)
    s = stack_push(s, 2)
    assert(stack_len(s) == 2)
    let top = stack_pop(s)
    assert(top["value"] == 2)
    s = stack_new()
    s = stack_push(s, top["value"])
    assert(stack_len(s) == 1)
    let q = queue_new()
    q = queue_push(q, 7)
    q = queue_push(q, 8)
    assert(queue_peek(q) == 7)
    q = queue_pop(q)
    assert(queue_peek(q) == 8)
    assert(queue_len(q) == 1)
    let m = {"a": 1}
    m = map_put(m, "b", 2)
    assert(map_get_or(m, "b", 0) == 2)
    assert(map_get_or(m, "zzz", 9) == 9)
    let h = heap_new_min()
    h = heap_push(h, 5)
    h = heap_push(h, 1)
    h = heap_push(h, 3)
    assert(heap_len(h) == 3)
    assert(heap_peek(h) == 1)
    let p1 = heap_pop(h)
    assert(p1["value"] == 1)
    h = p1["heap"]
    assert(heap_peek(h) == 3)
    assert(heap_sorted(h).join(",") == "3,5")
    let hx = heap_new_max()
    hx = heap_push(hx, 5)
    hx = heap_push(hx, 1)
    hx = heap_push(hx, 3)
    assert(heap_peek(hx) == 5)
    assert(heap_sorted(hx).join(",") == "5,3,1")
    let dq = deque_new()
    dq = deque_push_back(dq, 1)
    dq = deque_push_back(dq, 2)
    dq = deque_push_front(dq, 0)
    assert(deque_len(dq) == 3)
    assert(deque_peek_front(dq) == 0)
    assert(deque_peek_back(dq) == 2)
    let f1 = deque_pop_front(dq)
    assert(f1["value"] == 0)
    dq = f1["deque"]
    let b1 = deque_pop_back(dq)
    assert(b1["value"] == 2)
    dq = b1["deque"]
    assert(deque_len(dq) == 1)
    assert(deque_peek_front(dq) == 1)
    assert(deque_peek_back(dq) == 1)
    let o = omap_new()
    o = omap_put(o, "b", 2)
    o = omap_put(o, "a", 1)
    o = omap_put(o, "b", 20)
    assert(omap_len(o) == 2)
    assert(omap_keys(o).join(",") == "b,a")
    assert(omap_get(o, "b") == 20)
    assert(omap_get_or(o, "zzz", 9) == 9)
    assert(omap_contains(o, "a") == true)
    o = omap_remove(o, "b")
    assert(omap_len(o) == 1)
    assert(omap_keys(o)[0] == "a")
    assert(set_union([1, 2, 2], [2, 3]).join(",") == "1,2,3")
    assert(set_intersection([1, 2, 3], [2, 3, 4]).join(",") == "2,3")
    assert(set_difference([1, 2, 3], [2, 4]).join(",") == "1,3")
    assert(len(set_union([], [])) == 0)
    print("collections: OK")
    return 0
}
