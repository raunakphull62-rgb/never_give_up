// regex_test.klang — package self-test. Run: klang run regex_test.klang
import "lib.klang"

fn main() -> i32 {
    assert(rx_match("h.llo", "hello") == true)
    assert(rx_match("xyz", "hello") == false)
    assert(rx_find_or_empty("h.llo", "say hello") == "hello")
    assert(rx_find_or_empty("xyz", "hello") == "")
    assert(rx_matches_word("h.llo", "say hello", "hello") == true)
    assert(rx_count_words("a b c") == 3)
    assert(regex_matches("h.llo", "hello") == true)
    assert(regex_matches("xyz", "hello") == false)
    assert(regex_first("h.llo", "say hello") == "hello")
    assert(regex_first("xyz", "hello") == "")
    assert(regex_find_or("h.llo", "say hello", "dflt") == "hello")
    assert(regex_find_or("xyz", "hello", "dflt") == "dflt")
    let g = regex_groups("(\\w+)@(\\w+)", "bob@example")
    assert(len(g) == 2)
    assert(g[0] == "bob")
    assert(g[1] == "example")
    assert(len(regex_groups("xyz", "hello")) == 0)
    let n = regex_named_map("(?P<user>\\w+)", "bob")
    assert(n["user"] == "bob")
    print("regex: OK")
    return 0
}
